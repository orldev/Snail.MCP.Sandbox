<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <InvariantGlobalization>true</InvariantGlobalization>
        <RootNamespace>Snail.MCP.Sandbox</RootNamespace>
        <Version>0.1.0</Version>
        <Description>MCP server over streamable HTTP that runs Python written by a model in a throwaway container with no network, a read-only root and hard limits; built for Snail.Swarm.Agent, runs as the Nomad job mcp-sandbox on a node of class sandbox.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Docker.DotNet.Enhanced" Version="4.3.3"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.Sandbox.Tests"/>
    </ItemGroup>

</Project>
