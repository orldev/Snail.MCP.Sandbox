# Copy to .env beside compose.yml and change what differs on your machine.
# The registry both images come from; snail for images built on this host as the README's "Build and test" does.
REGISTRY=ghcr.io/orldev
# One tag for the server and the executor: they are released together, since the tool description names what
# the executor installs. latest follows every release; pin a version to update when you choose.
SANDBOX_TAG=latest
# The group that owns the Docker socket: stat -c %g /var/run/docker.sock
DOCKER_GID=
# runsc is gVisor. runc is for checking the rest of the confinement on a laptop, not for running work.
RUNTIME=runsc
# The object store as the links name it, host or host:port. Input files and projects are read from there only.
OBJECT_STORE=
# The address and port the server is reached at.
PUBLISH_ADDRESS=127.0.0.1
PUBLISH_PORT=8826
# The Docker network restores fetch packages over. Change it only when another stack on this daemon holds the name.
RESTORE_NETWORK=s3l-sandbox-restore
# The first three numbers of that network's /24. Change them only when the range is taken on this host.
RESTORE_SUBNET=10.213.26
